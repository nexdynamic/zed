#!/usr/bin/env bash
set -euo pipefail

ZED_VERSION=$(grep '^version' crates/zed/Cargo.toml | head -1 | cut -d'"' -f2)

# Find next nex index
LATEST=$(gh release list --limit 50 --json tagName -q '.[].tagName' \
  | grep "^v${ZED_VERSION}-nex\." \
  | sed "s/v${ZED_VERSION}-nex\.//" \
  | sort -n | tail -1 || true)

if [ -z "$LATEST" ]; then
  NEX_INDEX=0
else
  NEX_INDEX=$((LATEST + 1))
fi

TAG="v${ZED_VERSION}-nex.${NEX_INDEX}"
VERSION="${ZED_VERSION}-nex.${NEX_INDEX}"

# Sign with a stable identity so keychain "Always Allow" grants survive updates.
# An ad-hoc signed release would reset every user's keychain permissions.
SIGNING_IDENTITY="${MACOS_SIGNING_KEY:-Developer ID Application: Nexdynamic LTD (5K9M2PTCHJ)}"
if ! security find-identity -v -p codesigning | grep -qF "$SIGNING_IDENTITY"; then
  echo "error: signing identity \"$SIGNING_IDENTITY\" not found in keychain" >&2
  echo "Import the Nexdynamic Developer ID certificate (.p12) or set MACOS_SIGNING_KEY." >&2
  exit 1
fi
export MACOS_SIGNING_KEY="$SIGNING_IDENTITY"

echo "Building Nexdynamic ${VERSION} (signing as ${SIGNING_IDENTITY})..."

# Bake the nex index into the binary at compile time, restore on exit
echo "${NEX_INDEX}" > crates/zed/NEX_INDEX
trap 'echo "" > crates/zed/NEX_INDEX' EXIT

echo nexdynamic > crates/zed/RELEASE_CHANNEL
cargo clean -p auto_update 2>/dev/null || true
script/bundle-mac

DMG="target/aarch64-apple-darwin/release/Zed-aarch64.dmg"
if [ ! -f "$DMG" ]; then
  DMG="target/x86_64-apple-darwin/release/Zed-x86_64.dmg"
fi

echo "Creating GitHub release ${TAG}..."
gh release create "${TAG}" \
  "${DMG}" \
  --title "Nexdynamic ${TAG}" \
  --notes "Nexdynamic build ${TAG}"

echo "Done: ${TAG}"
